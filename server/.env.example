# Copy this file to .env and fill in your own values.

PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL (local install, or a free Neon database: https://neon.tech)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connectspace?schema=public"

# MongoDB (local install, or a free MongoDB Atlas cluster: https://www.mongodb.com/atlas)
MONGO_URI="mongodb://127.0.0.1:27017/connectspace"

# Fixes "querySrv ECONNREFUSED" with mongodb+srv:// addresses on some Windows networks.
DNS_SERVERS="8.8.8.8,1.1.1.1"

# Used in Week 2 for login tokens. Use any long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Image uploads. Leave empty in development (images are saved to server/uploads/).
# In production, paste the "API environment variable" from your Cloudinary dashboard:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_URL=

# Public address of this API (used to build local image URLs). Defaults to http://localhost:PORT
# PUBLIC_API_URL=http://localhost:5000
