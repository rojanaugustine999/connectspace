# Copy this file to .env and fill in your own values. On Render, set these in the service's Environment tab
# (render.yaml lists them).

PORT=5000
# The website's address (used for Socket.io CORS). Production: your Vercel URL, no trailing slash.
CLIENT_URL=http://localhost:3000

# PostgreSQL (local install, or a free Neon database: https://neon.tech). Use the DIRECT connection
# (no "-pooler" in the host) so `prisma migrate` works.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connectspace?schema=public"

# MongoDB (local install, or a free MongoDB Atlas cluster: https://www.mongodb.com/atlas)
MONGO_URI="mongodb://127.0.0.1:27017/connectspace"

# Development only: fixes "querySrv ECONNREFUSED" with mongodb+srv:// on some Windows networks.
# Not needed on Render.
DNS_SERVERS="8.8.8.8,1.1.1.1"

# Signs login tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Image uploads. Leave empty in development (images are saved to server/uploads/).
# REQUIRED in production: paste the "API environment variable" from your Cloudinary dashboard:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_URL=

# Public address of this API (used to build local image URLs). Defaults to http://localhost:PORT
# PUBLIC_API_URL=http://localhost:5000

# Shared secret with the Next.js middleware (client PROXY_SECRET, same value).
# Requests that carry it may tell us the visitor's real IP (for per-visitor rate limits).
PROXY_SECRET=

# Production only: proxies in front of the app for DIRECT API calls (Render's edge network + its
# load balancer). Website traffic uses PROXY_SECRET instead. Leave unset in development.
# TRUST_PROXY_HOPS=3

# NODE_ENV=production   (set on Render: secure cookies, production logging, stricter env checks)
