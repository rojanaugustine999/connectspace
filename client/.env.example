# Copy this file to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.

# Where Next.js forwards /api/* requests (server-side only: never sent to the browser).
API_ORIGIN=http://localhost:5000

# Where the browser opens the Socket.io connection (NEXT_PUBLIC_ = visible in the browser, so no secrets).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Server-side only. Must be the same value as PROXY_SECRET in server/.env (and on Render).
# Lets the API trust the visitor IP that middleware.js passes on. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=
